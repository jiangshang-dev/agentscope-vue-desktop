{
  "name": "agentscope-vue-desktop",
  "version": "0.1.0",
  "description": "AgentScope Desktop Client (Electron + Vue3 + Ant Design Vue)",
  "main": "./out/main/index.js",
  "author": "AgentOS",
  "license": "MIT",
  "scripts": {
    "dev": "env -u ELECTRON_RUN_AS_NODE electron-vite dev",
    "build": "env -u ELECTRON_RUN_AS_NODE electron-vite build",
    "preview": "env -u ELECTRON_RUN_AS_NODE electron-vite preview",
    "postinstall": "node node_modules/electron/install.js",
    "reinstall:electron": "node node_modules/electron/install.js",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web"
  },
  "dependencies": {
    "@ant-design/icons-vue": "^7.0.1",
    "ant-design-vue": "^4.2.6",
    "axios": "^1.11.0",
    "dayjs": "^1.11.13",
    "pinia": "^3.0.3",
    "vue": "^3.5.18",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@electron-toolkit/utils": "^4.0.0",
    "@types/node": "^22.17.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "electron": "^37.2.5",
    "electron-vite": "^4.0.0",
    "typescript": "^5.9.2",
    "vite": "^7.0.6",
    "vue-tsc": "^3.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "core-js"
    ]
  }
}
