{
  "name": "agentscope-vue-desktop",
  "version": "0.1.0",
  "description": "AgentScope Desktop Client (Electron + Vue3 + Ant Design Vue)",
  "main": "./out/main/index.js",
  "author": "AgentOS",
  "license": "MIT",
  "scripts": {
    "dev": "env -u ELECTRON_RUN_AS_NODE electron-vite dev",
    "build": "env -u ELECTRON_RUN_AS_NODE electron-vite build",
    "preview": "env -u ELECTRON_RUN_AS_NODE electron-vite preview",
    "postinstall": "node node_modules/electron/install.js",
    "reinstall:electron": "node node_modules/electron/install.js",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "gen:license": "node scripts/gen-license.mjs",
    "dist": "npm run build && env -u ELECTRON_RUN_AS_NODE electron-builder",
    "dist:mac": "npm run build && env -u ELECTRON_RUN_AS_NODE electron-builder --mac dmg",
    "dist:win": "npm run build && env -u ELECTRON_RUN_AS_NODE electron-builder --win nsis portable",
    "dist:dir": "npm run build && env -u ELECTRON_RUN_AS_NODE electron-builder --dir"
  },
  "dependencies": {
    "@ant-design/icons-vue": "^7.0.1",
    "ant-design-vue": "^4.2.6",
    "axios": "^1.11.0",
    "dayjs": "^1.11.13",
    "dompurify": "^3.4.13",
    "marked": "^18.0.9",
    "pinia": "^3.0.3",
    "vue": "^3.5.18",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@electron-toolkit/utils": "^4.0.0",
    "@types/dompurify": "^3.2.0",
    "@types/node": "^22.17.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "electron": "^37.2.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^4.0.0",
    "typescript": "^5.9.2",
    "vite": "^7.0.6",
    "vue-tsc": "^3.0.5"
  },
  "build": {
    "appId": "com.agentscope.desktop",
    "productName": "AgentOS",
    "copyright": "Copyright © AgentOS",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "AgentOS"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development"
    }
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "core-js"
    ]
  }
}
